{
  "name": "phase-bc-fullstack-app",
  "version": "1.0.0",
  "description": "Full-stack capstone project combining Phase B (TypeScript API + Playwright E2E) and Phase C (React + Vite + CSS Advanced + A11y)",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "npx tsx server/index.ts",
    "dev:client": "npx vite",
    "build": "npx tsc && npx vite build",
    "test:api": "npx playwright test tests/api.spec.ts",
    "test:e2e": "npx playwright test tests/e2e.spec.ts",
    "test:a11y": "npx playwright test tests/a11y.spec.ts",
    "test": "npx playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.45.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
